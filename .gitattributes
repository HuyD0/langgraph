# Append-only files: when two branches both append, keep both sides instead of a conflict.
tests/fixtures/lesson_ids.txt merge=union
src/drill/content/checks/*.py merge=union
# Generated by tools (drill tutor prepare, screenshots.mjs): folded in pull request review.
src/drill/content/prepared/*.json linguist-generated=true
docs/screens/*.webp linguist-generated=true
# Every text file is stored and checked out with LF line endings, Windows included, so a file
# written on Windows doesn't show up as changed on every line, and fingerprints match everywhere.
* text=auto eol=lf
*.ps1 text eol=crlf
