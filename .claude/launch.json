{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "drill-server",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "drill-server"
      ],
      "port": 8787
    },
    {
      "name": "drill-server-branch",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DRILL_PORT=8788",
        "DRILL_DATABASE_URL=sqlite:///.drill/preview.db",
        "uv",
        "run",
        "drill-server"
      ],
      "port": 8788
    },
    {
      "name": "drill-server-screens",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DRILL_PORT=8791",
        "DRILL_DATABASE_URL=sqlite:///.drill/screens.db",
        "uv",
        "run",
        "drill-server"
      ],
      "port": 8791
    },
    {
      "name": "drill-server-journey",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DRILL_PORT=8792",
        "DRILL_DATABASE_URL=sqlite:///.drill/journey.db",
        "uv",
        "run",
        "drill-server"
      ],
      "port": 8792
    }
  ]
}
