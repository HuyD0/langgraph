# Copy to .env and fill in. .env is gitignored.
# Only ONE of the endpoint styles below is needed - see README.md.

# --- Azure OpenAI deployments (endpoint ends in .openai.azure.com) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_KEY=<your-key>
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- OR: Foundry models endpoint (ends in .services.ai.azure.com/models) ---
# AZURE_INFERENCE_ENDPOINT=https://<your-resource>.services.ai.azure.com/models
# AZURE_OPENAI_DEPLOYMENT=<your-model-name>
# AZURE_OPENAI_API_KEY=<your-key>

# --- OR: service principal instead of a key (leave the key unset) ---
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- OR: a local model under Ollama (no Azure, no key). Wins over the above. ---
# OLLAMA_MODEL=gemma3:12b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- OR: an MLflow AI Gateway endpoint (needs the MLflow server running). Wins over all. ---
# MLFLOW_GATEWAY_ENDPOINT=drill-tutor
# MLFLOW_GATEWAY_URL=http://localhost:5050/gateway/mlflow/v1
# MLFLOW_TRACKING_URI=http://localhost:5050

# --- The local tutor server: uv run drill-server (see README.md) ---
# It uses Ollama first (OLLAMA_MODEL above, or whatever Ollama has pulled) and a hosted
# model as the fallback: either the Azure settings above, or any OpenAI-compatible
# endpoint named here, such as a Databricks serving endpoint.
# DRILL_HOSTED_BASE_URL=https://adb-<workspace id>.<n>.azuredatabricks.net/serving-endpoints
# DRILL_HOSTED_MODEL=<endpoint-name>
# DRILL_HOSTED_API_KEY=<token>
# DRILL_HOSTED_DAILY_TOKENS=200000   # stop using the hosted model past this many tokens a day
# DRILL_MAX_PROMPT_CHARS=60000       # refuse a request bigger than this (about 15,000 tokens)
# DRILL_CACHE_DAYS=7                 # forget a cached answer after this many days
# DRILL_CACHE_MAX=2000               # keep at most this many cached answers
# DRILL_FIRST_WORD_SECONDS=45        # give up on a model that has not started answering by then
# DRILL_THINKING=complex             # off | complex | on: when a thinking model (qwen3...) may think
# DRILL_TRACING=1                    # 0 switches off the MLflow trace per answer (see MLFLOW_TRACKING_URI)
# DRILL_HOST=0.0.0.0                 # the default: every network interface, no sign-in, so anyone on
#                                    # the same Wi-Fi can open it; 127.0.0.1 keeps it to this machine
# DRILL_PORT=8787
# DRILL_DATABASE_URL=sqlite:///.drill/drill.db   # or postgresql+psycopg://... later
# DRILL_OWNER=local                  # whose rows a local store reads and writes (Lakebase uses your login)
# DRILL_DB_SCHEMA=                   # the Postgres schema for the tables (the app uses drill); empty = the default
# DRILL_USER_HEADER=x-forwarded-email  # the header a login proxy sets to say who is asking
# DRILL_TRUST_USER_HEADER=0          # 1 believes that header outside a Databricks App. ONLY behind a login
#                                    # proxy that sets it itself: otherwise anyone who can reach the port
#                                    # can send the header and read or write any person's rows
# DRILL_CONTENT_PACKS=               # content pack folders to load, separated by ':' (see docs/CONTENT_PACKS.md);
#                                    # a folder that doesn't exist is skipped
# DRILL_SHOW_DRAFTS=0                # 1 shows a pack's draft lessons, marked Draft (drill content preview sets it)
# DRILL_TEAM_SUMMARIES=              # the managers' weekly notes: on with a shared database, off with SQLite;
#                                    # 1 or 0 forces it
# DRILL_IDLE_STOP_MINUTES=0          # Databricks App only: stop after this many idle minutes (app.yaml says 30)
# DRILL_MLFLOW_EXPERIMENT_ID=        # an experiment by id, how a Databricks App names the one attached to it;
#                                    # wins over DRILL_MLFLOW_EXPERIMENT below
# DRILL_CHECKS_AS_FEEDBACK=1         # write each answer's checks to its trace as feedback; 0 (the app) keeps
#                                    # them as tags and a span, and `drill traces score` adds them in a batch

# --- Optional tuning ---
# Sampling temperature. Leave it EMPTY (not unset) to omit the parameter entirely,
# which the gpt-5 family and o-series require - they reject any value but their own
# default. scripts/azure_up.sh detects this and sets it for you.
# DRILL_TEMPERATURE=0.2
# DRILL_MAX_ATTEMPTS=3
# DRILL_SANDBOX_TIMEOUT=10
# DRILL_MLFLOW_EXPERIMENT=daily-drill
#
# Traces to your Databricks workspace instead (set up and check with `uv run drill tracing
# check`; with a workspace storage firewall, keep them in Unity Catalog, see docs/SERVER.md):
# MLFLOW_TRACKING_URI=databricks
# DATABRICKS_CONFIG_PROFILE=DEFAULT
# MLFLOW_TRACING_SQL_WAREHOUSE_ID=<id>   # reading Unity Catalog traces needs a SQL warehouse
