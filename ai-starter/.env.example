# ---- Azure OpenAI (preferred: `az login` + DefaultAzureCredential, no key needed) ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Only set this if you are NOT using az login / Entra ID auth:
# AZURE_OPENAI_API_KEY=

# ---- Databricks (preferred: `databricks auth login`, which writes ~/.databrickscfg) ----
# DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
# DATABRICKS_TOKEN=
# Model serving endpoint name to use when LLM_PROVIDER=databricks
DATABRICKS_LLM_ENDPOINT=databricks-claude-sonnet-5-5

# "azure" or "databricks"
LLM_PROVIDER=azure

# ---- Observability (optional) ----
# MLflow tracing. Local by default: view traces with `uv run mlflow ui --backend-store-uri sqlite:///mlflow.db`
# To send traces to Databricks instead, use the two commented lines (needs the workspace storage
# account to accept uploads from your network; it currently returns 403 AuthorizationFailure).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=ai-starter
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_NAME=/Users/huy.d@hotmail.com/ai-starter
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
